# Etherscan API Keys
# Obtén tu API key gratuita en: https://etherscan.io/apis

# Sepolia Testnet
VITE_ETHERSCAN_API_KEY_SEPOLIA=YourApiKeyToken

# Ethereum Mainnet
VITE_ETHERSCAN_API_KEY_MAINNET=YourApiKeyToken

# Polygon
VITE_POLYGONSCAN_API_KEY=YourApiKeyToken

# BSC
VITE_BSCSCAN_API_KEY=YourApiKeyToken

# Avalanche
VITE_SNOWTRACE_API_KEY=YourApiKeyToken

# Supabase (para guardar transacciones del contrato)
# Crea un proyecto en https://supabase.com
# 1. Crea proyecto → Copia URL y anon key
# 2. En SQL Editor ejecuta el script de creación de tabla (ver README)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
